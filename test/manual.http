@baseUrl = http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — Guest endpoints (no token required)
# ─────────────────────────────────────────────────────────────────────────────

### Register new user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "full_name": "Joko Morro",
  "email": "joko@example.com",
  "password": "Password123!"
}

### Verify email with OTP (lihat kode OTP di server log)
POST {{baseUrl}}/api/auth/verify-email
Content-Type: application/json

{
  "email": "joko@example.com",
  "otp_code": "123456"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "joko@example.com",
  "password": "Password123!"
}

### Refresh access token
# @name refresh
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{login.response.body.$.data.refresh_token}}"
}

### Resend OTP
POST {{baseUrl}}/api/auth/otp/resend
Content-Type: application/json

{
  "email": "joko@example.com",
  "purpose": "email_verification"
}

### Forgot password (request reset OTP)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "joko@example.com"
}

### Reset password with OTP
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "joko@example.com",
  "otp_code": "123456",
  "new_password": "NewPassword456!"
}

### OAuth — Google (redirect)
GET {{baseUrl}}/api/auth/google

### OAuth — Apple (redirect)
GET {{baseUrl}}/api/auth/apple

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — Protected endpoints (token otomatis dari response Login di atas)
# ─────────────────────────────────────────────────────────────────────────────

### Get current user profile
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Logout (revoke refresh token)
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "refresh_token": "{{login.response.body.$.data.refresh_token}}"
}