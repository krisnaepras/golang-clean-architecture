# Application
APP_NAME=golang-clean-architecture

# HTTP Server
WEB_PORT=3000
WEB_PREFORK=false

# Logging (logrus levels: 1=Fatal, 2=Error, 3=Warn, 4=Info, 5=Debug, 6=Trace)
LOG_LEVEL=6

# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
# Supported drivers: postgres (default), mysql
DATABASE_DRIVER=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=golang_clean_architecture

DB_POOL_IDLE=10
DB_POOL_MAX=100
DB_POOL_LIFETIME=300

# ----------------------------------------------------------------
# MySQL example (copy and uncomment when using MySQL)
# ----------------------------------------------------------------
# DATABASE_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_NAME=golang_clean_architecture

# ----------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=golang-clean-architecture
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_PRODUCER_ENABLED=false
KAFKA_CONSUMER_ENABLED=false

# ----------------------------------------------------------------
# JWT
# ----------------------------------------------------------------
JWT_SECRET=dreampod-super-secret-jwt-key-change-in-production

# ----------------------------------------------------------------
# SMTP / Email (go-mail + Mailtrap sandbox untuk development)
# Isi credentials Mailtrap di: https://mailtrap.io → Inboxes → SMTP Settings
# Kosongkan SMTP_HOST untuk disable pengiriman email (OTP hanya di-log)
# ----------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.app
SMTP_FROM_NAME=myexampleapp

# ----------------------------------------------------------------
# Google OAuth
# ----------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback